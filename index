// MULTIPLIER ENGINE
// ═══════════════════════════════════════
function effOut(tech){
  let m=G.rebirthMult;
  RES.forEach(r=>{
    if(!r.id||!G.bought[r.id]||!r.m)return;
    const tgs=TGT[r.tg];
    if(tgs===null||tgs.includes(tech.id))m*=r.m;
  });
  // perm upgrades from events
  if(G.permUpgrades[tech.id])m*=G.permUpgrades[tech.id];
  m*=G.eventMod;
  return tech.out*m;
}
function effCR(tech){
  let m=Math.sqrt(G.rebirthMult);
  RES.forEach(r=>{
    if(!r.id||!G.bought[r.id]||!r.m)return;
    const tgs=TGT[r.tg];
    if(tgs===null||tgs.includes(tech.id))m*=Math.sqrt(r.m);
  });
  m*=G.crEventMod;
  return tech.cr*m;
}
function recalc(){
  let pw=0,cr=0;
  Object.values(G.cells).forEach(c=>{
    const t=TECHS.find(t=>t.id===c.id);
    if(t){pw+=effOut(t);cr+=effCR(t);}
  });
  G.currentPower=pw;G.creditRate=cr;
  reRender();
}

