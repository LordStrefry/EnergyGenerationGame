  {id:'stellar',n:'Stellar Engine',ic:'🌠',era:'V',en:'Stellar Engineering',cost:20e6,out:500e9,gl:'gdy',desc:'Shkadov thruster.',unl:500e9,cr:300000},
  // ERA VI — DPE
  {id:'dpe',n:'Dyson-Penrose Engine',ic:'🕳',era:'VI',en:'DPE Era',cost:100e6,out:1e25,gl:'gdpe',desc:'White dwarf + Kerr BH. Symbiotic. Trillions of years.',unl:5e12,cr:1e10},
  // ERA VII — DCSAL
  {id:'dcsal',n:'DCSAL',ic:'⚡',era:'VII',en:'Chapter VI',cost:1e9,out:1e28,gl:'gdcs',desc:'Parabolic mirror → ergosphere. Superradiant amplification loop.',unl:1e25,cr:1e13},
  // ERA VIII — MPSC
  {id:'mpsc',n:'MPSC',ic:'🌌',era:'VIII',en:'Chapter VII',cost:1e12,out:1e42,gl:'gmp',desc:'Magnetar jets quark matter into ergosphere. Galaxy output. 63 years.',unl:1e28,cr:1e18},
