function fp(w){
  if(!isFinite(w)||w<=0)return'0 W';
  if(w>=1e80)return(w/1e80).toFixed(1)+'×10⁸⁰ W';
  if(w>=1e65)return(w/1e65).toFixed(2)+'×10⁶⁵ W';
  if(w>=1e54)return(w/1e54).toFixed(2)+'×10⁵⁴ W';
  if(w>=1e42)return(w/1e42).toFixed(1)+'×10⁴² W';
  if(w>=1e28)return(w/1e28).toFixed(2)+'×10²⁸ W';
  if(w>=1e25)return(w/1e25).toFixed(2)+'×10²⁵ W';
  if(w>=1e12)return(w/1e12).toFixed(2)+' TW';
  if(w>=1e9)return(w/1e9).toFixed(2)+' GW';
  if(w>=1e6)return(w/1e6).toFixed(2)+' MW';
  if(w>=1e3)return(w/1e3).toFixed(1)+' kW';
  return Math.round(w)+' W';
}
function fe(e){
  if(!isFinite(e)||e<=0)return'0 Wh';
  if(e>=1e80)return(e/1e80).toFixed(1)+'×10⁸⁰ Wh';
  if(e>=1e65)return(e/1e65).toFixed(2)+'×10⁶⁵ Wh';
  if(e>=1e54)return(e/1e54).toFixed(2)+'×10⁵⁴ Wh';
  if(e>=1e42)return(e/1e42).toFixed(1)+'×10⁴² Wh';
  if(e>=1e28)return(e/1e28).toFixed(2)+'×10²⁸ Wh';
  if(e>=1e25)return(e/1e25).toFixed(2)+'×10²⁵ Wh';
  if(e>=1e12)return(e/1e12).toFixed(2)+' TWh';
  if(e>=1e9)return(e/1e9).toFixed(2)+' GWh';
  if(e>=1e6)return(e/1e6).toFixed(2)+' MWh';
  if(e>=1e3)return(e/1e3).toFixed(1)+' kWh';
  return Math.round(e)+' Wh';
}
function fc(c){
  if(!isFinite(c)||c<=0)return'0 ¢';
  if(c>=1e15)return(c/1e15).toFixed(2)+' P¢';
  if(c>=1e12)return(c/1e12).toFixed(2)+' T¢';
  if(c>=1e9)return(c/1e9).toFixed(2)+' G¢';
  if(c>=1e6)return(c/1e6).toFixed(2)+' M¢';
  if(c>=1e3)return(c/1e3).toFixed(1)+' k¢';
  return Math.round(c)+' ¢';
}

