function buildGrid(){
  const g=document.getElementById('grid');
  g.style.gridTemplateColumns=`repeat(${G.gridCols},var(--cell))`;
  g.style.gridTemplateRows=`repeat(${G.gridRows},var(--cell))`;
  g.innerHTML='';
  for(let r=0;r<G.gridRows;r++){
    for(let c=0;c<G.gridCols;c++){
      const k=`${r},${c}`;
      const el=document.createElement('div');
      el.className='cell';el.id=`c-${k}`;
      el.innerHTML=`<span style="font-size:9px;color:#1a3050">+</span>`;
      el.addEventListener('click',()=>onCell(k));
      g.appendChild(el);
    }
  }
  Object.keys(G.cells).forEach(k=>renderCell(k));
  resizeCv();
}

function renderCell(k){
  const el=document.getElementById(`c-${k}`);
  if(!el)return;
  const d=G.cells[k];
  if(!d){el.className='cell';el.innerHTML=`<span style="font-size:9px;color:#1a3050">+</span>`;return;}
  const t=TECHS.find(t=>t.id===d.id);
  if(!t)return;
  el.className=`cell occ ${t.gl}`;
  el.innerHTML=`<div class="ci">${t.ic}</div><div class="cn">${t.n}</div><div class="co">${fp(effOut(t))}</div>`;
}
function reRender(){Object.keys(G.cells).forEach(k=>renderCell(k));}

