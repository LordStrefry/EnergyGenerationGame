<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Energy Ascension</title>
<link href="https://fonts.googleapis.com/css2?family=Share+Tech+Mono&family=Orbitron:wght@400;700;900&display=swap" rel="stylesheet">
<style>
:root{
  --bg:#080c10;--bg2:#0d1520;--bg3:#111d2e;--panel:#0a1628;
  --border:#1a3050;--border2:#2a4870;--text:#c8dff5;--muted:#5a7a9a;
  --accent:#00c8ff;--accent2:#00ff9d;--gold:#ffd700;--red:#ff4444;
  --orange:#ff8c00;--purple:#a855f7;--white:#e8f4ff;--cell:72px;
  --rebirth-hue:0deg;
}
*{margin:0;padding:0;box-sizing:border-box;}
body{background:var(--bg);color:var(--text);font-family:'Share Tech Mono',monospace;overflow:hidden;height:100vh;display:flex;flex-direction:column;transition:filter .3s;}
body.shake{animation:shake .4s ease-out;}
@keyframes shake{0%,100%{transform:translate(0)}20%{transform:translate(-4px,2px)}40%{transform:translate(4px,-3px)}60%{transform:translate(-3px,4px)}80%{transform:translate(3px,-2px)}}

/* HEADER */
#header{background:var(--panel);border-bottom:1px solid var(--border);padding:5px 12px;display:flex;align-items:center;gap:10px;flex-shrink:0;flex-wrap:wrap;}
#gtitle{font-family:'Orbitron';font-size:13px;font-weight:900;color:var(--accent);letter-spacing:3px;white-space:nowrap;}
.sblk{background:var(--bg3);border:1px solid var(--border);border-radius:4px;padding:3px 8px;min-width:82px;}
.slbl{font-size:7px;color:var(--muted);text-transform:uppercase;letter-spacing:1px;}
.sval{font-size:11px;color:var(--accent2);font-weight:bold;white-space:nowrap;}
.srate{font-size:7px;color:var(--muted);white-space:nowrap;}
.srate b{color:var(--gold);}
#rebirth-blk{background:linear-gradient(135deg,#1a0a2e,#2a1050);border:1px solid var(--purple);border-radius:4px;padding:3px 8px;}
#rebirth-blk .slbl{color:#c084fc;}
#rebirth-blk .sval{color:#e879f9;}
#era-disp{font-family:'Orbitron';font-size:8px;color:var(--gold);letter-spacing:2px;margin-left:auto;white-space:nowrap;}
#spd{display:flex;gap:3px;}
.sb{background:var(--bg3);border:1px solid var(--border);color:var(--muted);font-family:'Share Tech Mono';font-size:10px;padding:3px 7px;cursor:pointer;border-radius:3px;transition:all .15s;}
.sb:hover,.sb.on{border-color:var(--accent);color:var(--accent);}

/* LAYOUT */
#main{display:flex;flex:1;overflow:hidden;}

/* LEFT TECH */
#tp{width:200px;background:var(--panel);border-right:1px solid var(--border);display:flex;flex-direction:column;flex-shrink:0;overflow:hidden;}
#tp h3,#rp h3{font-family:'Orbitron';font-size:8px;letter-spacing:2px;color:var(--muted);padding:6px 10px;border-bottom:1px solid var(--border);text-transform:uppercase;}
#tlist{flex:1;overflow-y:auto;padding:4px;}
#tlist::-webkit-scrollbar{width:3px;}
#tlist::-webkit-scrollbar-thumb{background:var(--border2);}
.ti{border:1px solid var(--border);border-radius:4px;padding:5px 7px;margin-bottom:3px;cursor:pointer;transition:border-color .15s,background .15s;background:var(--bg3);}
.ti:hover:not(.lk){border-color:var(--border2);}
.ti.sel{border-color:var(--accent);background:#0a1f35;}
.ti.lk{opacity:.28;cursor:not-allowed;}
.tn{font-size:10px;color:var(--white);font-weight:bold;}
.tm{font-size:7px;color:var(--muted);margin-top:1px;}
.tc{font-size:7px;color:var(--gold);margin-top:1px;}
.tu{font-size:7px;color:#ff8844;margin-top:1px;}
.th{font-size:7px;color:var(--orange);letter-spacing:2px;text-transform:uppercase;padding:5px 2px 2px;border-top:1px solid var(--border);margin-top:3px;}
.th:first-child{border-top:none;margin-top:0;}
.th.exotic{color:#e879f9;}
.th.omega-hdr{color:#ff0;animation:omgpulse 1s ease-in-out infinite;}
@keyframes omgpulse{0%,100%{color:#ff0;text-shadow:0 0 6px #ff0;}50%{color:#fff;text-shadow:0 0 12px #fff;}}

/* GRID */
#ga{flex:1;display:flex;flex-direction:column;overflow:hidden;position:relative;}
#gw{flex:1;overflow:auto;position:relative;}
#gw::-webkit-scrollbar{width:5px;height:5px;}
#gw::-webkit-scrollbar-thumb{background:var(--border2);border-radius:2px;}
#pc{position:absolute;top:0;left:0;pointer-events:none;z-index:10;}
#grid{display:grid;gap:2px;padding:14px;width:max-content;position:relative;z-index:1;}
.cell{width:var(--cell);height:var(--cell);border:1px solid #0f2040;background:#050d18;border-radius:3px;cursor:pointer;display:flex;align-items:center;justify-content:center;transition:border-color .15s,background .15s;position:relative;flex-direction:column;gap:1px;}
.cell:hover:not(.occ){border-color:var(--border2);background:#0a1628;}
.ci{font-size:20px;line-height:1;}
.cn{font-size:6px;color:var(--muted);text-align:center;max-width:66px;overflow:hidden;white-space:nowrap;text-overflow:ellipsis;}
.co{font-size:6px;color:var(--accent2);}

/* CELL GLOWS */
.gc{box-shadow:0 0 8px #ff440028;border-color:#553300;}
.go{box-shadow:0 0 8px #ff880028;border-color:#664400;}
.gg{box-shadow:0 0 8px #ffcc0028;border-color:#665500;}
.gn{box-shadow:0 0 10px #00ff0040;border-color:#004400;animation:bl 3s ease-in-out infinite;}
.gs{box-shadow:0 0 10px #ffdd0028;border-color:#664400;}
.gw2{box-shadow:0 0 8px #88ddff28;border-color:#224466;}
.gh{box-shadow:0 0 8px #0088ff28;border-color:#003366;}
.ggeo{box-shadow:0 0 10px #ff440028;border-color:#441100;}
.gf{box-shadow:0 0 14px #ff880055;border-color:#885500;animation:bl 1.5s ease-in-out infinite;}
.gorb{box-shadow:0 0 14px #ffdd0045;border-color:#886600;}
.ganti{box-shadow:0 0 16px #ff00ff45;border-color:#660066;animation:bl 1s ease-in-out infinite;}
.gdy{box-shadow:0 0 18px #ff990055;border-color:#885500;}
.gdpe{box-shadow:0 0 22px #00ffff60,0 0 44px #00ffff20;border-color:#006688;animation:dp 1.5s ease-in-out infinite;}
.gdcs{box-shadow:0 0 26px #ff990060,0 0 52px #ff990020;border-color:#996600;animation:dp 1s ease-in-out infinite;}
.gmp{box-shadow:0 0 30px #ff00ff60,0 0 60px #ff00ff28,0 0 90px #ff00ff10;border-color:#990066;animation:mp .7s ease-in-out infinite;}
/* NEW EXOTIC GLOWS */
.gpulsar{box-shadow:0 0 20px #ffffff70,0 0 40px #88aaff40;border-color:#aabbff;animation:pulsarblink .3s ease-in-out infinite;}
@keyframes pulsarblink{0%,100%{opacity:1;}50%{opacity:.6;}}
.gquasar{box-shadow:0 0 28px #ff440080,0 0 56px #ff880040;border-color:#ff6600;animation:dp .5s ease-in-out infinite;}
.gnmerge{box-shadow:0 0 24px #66ffff70,0 0 48px #ff66ff40;border-color:#88ffee;animation:mp .4s ease-in-out infinite;}
.gzpt{box-shadow:0 0 20px #ffffff50,0 0 40px #aaaaff30;border-color:#ccccff;animation:zptanim 2s ease-in-out infinite;}
@keyframes zptanim{0%,100%{box-shadow:0 0 20px #ffffff50,0 0 40px #aaaaff30;}50%{box-shadow:0 0 30px #ffffffa0,0 0 60px #aaaaff60;}}
.gvac{box-shadow:0 0 22px #ffaa0060,0 0 44px #ff550030;border-color:#ffaa00;animation:bl .8s ease-in-out infinite;}
.gcstr{box-shadow:0 0 26px #00ffaa70,0 0 52px #00ff5530;border-color:#00ffaa;animation:dp .6s ease-in-out infinite;}
.gbrane{box-shadow:0 0 30px #ff00aa70,0 0 60px #aa00ff40,0 0 90px #0000ff20;border-color:#ff00aa;animation:braneflicker .4s ease-in-out infinite;}
@keyframes braneflicker{0%,100%{opacity:1;transform:scale(1);}33%{opacity:.8;transform:scale(1.01);}66%{opacity:.9;transform:scale(.99);}}
/* KARDASHEV */
.gkd1{box-shadow:0 0 20px #00ff8870,0 0 40px #00ff4430;border-color:#00ff88;}
.gkd2{box-shadow:0 0 24px #ffcc0070,0 0 48px #ff880030;border-color:#ffcc00;}
.gkd3{box-shadow:0 0 28px #ff44ff70,0 0 56px #aa00ff30;border-color:#ff44ff;animation:dp .8s ease-in-out infinite;}
.gkd4{box-shadow:0 0 32px #00ccff80,0 0 64px #aa00ff40,0 0 128px #ff000020;border-color:#00ccff;animation:kd4anim 1s ease-in-out infinite;}
@keyframes kd4anim{0%,100%{box-shadow:0 0 32px #00ccff80,0 0 64px #aa00ff40;}50%{box-shadow:0 0 48px #00ccffb0,0 0 96px #aa00ff60,0 0 192px #ff000030;}}
/* OMEGA */
.gomega{border-color:#fff;animation:omegaanim .5s ease-in-out infinite;}
@keyframes omegaanim{
  0%{box-shadow:0 0 40px #ffff0090,0 0 80px #ff880060,0 0 120px #ff000040;border-color:#ffff00;}
  25%{box-shadow:0 0 40px #00ffff90,0 0 80px #0088ff60,0 0 120px #aa00ff40;border-color:#00ffff;}
  50%{box-shadow:0 0 40px #ff00ff90,0 0 80px #aa0088ff,0 0 120px #ffffff40;border-color:#ff00ff;}
  75%{box-shadow:0 0 40px #ffffff90,0 0 80px #ffff0060,0 0 120px #00ffff40;border-color:#ffffff;}
  100%{box-shadow:0 0 40px #ffff0090,0 0 80px #ff880060,0 0 120px #ff000040;border-color:#ffff00;}
}
@keyframes bl{0%,100%{opacity:1;}50%{opacity:.65;}}
@keyframes dp{0%,100%{opacity:1;transform:scale(1);}50%{opacity:.85;transform:scale(1.02);}}
@keyframes mp{0%,100%{opacity:1;}50%{opacity:.72;}}

/* BOTTOM BAR */
#bb{background:var(--panel);border-top:1px solid var(--border);padding:5px 10px;display:flex;gap:8px;align-items:center;flex-shrink:0;min-height:40px;}
#it{font-size:9px;color:var(--muted);flex:1;line-height:1.5;}
#it span{color:var(--text);}
#dbtn{background:transparent;color:var(--red);border:1px solid var(--red);font-family:'Orbitron';font-size:8px;padding:5px 10px;border-radius:4px;cursor:pointer;transition:all .15s;text-transform:uppercase;}
#dbtn:hover{background:#ff444415;}
#dbtn.on{background:var(--red);color:#fff;}
#plbtn{background:var(--accent);color:var(--bg);font-family:'Orbitron';font-size:8px;font-weight:700;padding:5px 14px;border:none;border-radius:4px;cursor:pointer;transition:all .15s;text-transform:uppercase;}
#plbtn:hover{background:#00aadd;}
#plbtn:disabled{background:var(--border);color:var(--muted);cursor:not-allowed;}

/* RIGHT RESEARCH */
#rp{width:210px;background:var(--panel);border-left:1px solid var(--border);display:flex;flex-direction:column;flex-shrink:0;}
#rpanel{flex:1;overflow-y:auto;padding:4px;}
#rpanel::-webkit-scrollbar{width:3px;}
#rpanel::-webkit-scrollbar-thumb{background:var(--border2);}
.rcat{font-size:7px;color:var(--purple);letter-spacing:2px;text-transform:uppercase;padding:5px 2px 2px;border-top:1px solid var(--border);margin-top:3px;}
.rcat:first-child{border-top:none;margin-top:0;}
.ui{border:1px solid var(--border);border-radius:4px;padding:5px 7px;margin-bottom:3px;background:var(--bg3);cursor:pointer;transition:border-color .15s;}
.ui:hover:not(.bought){border-color:var(--purple);}
.ui.bought{opacity:.38;cursor:default;}
.ui.omega-res{border-color:#ff000040;background:#1a0a00;}
.ui.omega-res:hover:not(.bought){border-color:#ff4400;}
.ui.rebirth-res{border-color:#88008840;background:#0a0015;}
.ui.rebirth-res:hover:not(.bought){border-color:#e879f9;}
.un{font-size:9px;color:var(--white);}
.ud{font-size:7px;color:var(--muted);margin-top:2px;line-height:1.4;}
.uc{font-size:7px;color:var(--purple);margin-top:2px;}

/* NOTIF */
#notif{position:fixed;top:52px;right:14px;background:var(--bg3);border:1px solid var(--accent);border-radius:6px;padding:7px 13px;font-size:9px;color:var(--accent);max-width:240px;opacity:0;transform:translateY(-8px);transition:all .3s;pointer-events:none;z-index:300;font-family:'Orbitron';letter-spacing:1px;}
#notif.on{opacity:1;transform:translateY(0);}

/* EVENT BANNER */
#event-banner{position:fixed;top:50%;left:50%;transform:translate(-50%,-50%) scale(.9);background:var(--panel);border:2px solid var(--orange);border-radius:10px;padding:24px 40px;text-align:center;max-width:420px;z-index:350;opacity:0;pointer-events:none;transition:all .4s;}
#event-banner.on{opacity:1;transform:translate(-50%,-50%) scale(1);pointer-events:all;}
#eb-title{font-family:'Orbitron';font-size:16px;color:var(--orange);margin-bottom:8px;}
#eb-desc{font-size:11px;color:var(--text);line-height:1.7;margin-bottom:14px;}
#eb-effect{font-size:10px;color:var(--accent2);margin-bottom:14px;}
#eb-close{background:var(--orange);color:#000;font-family:'Orbitron';font-size:10px;font-weight:700;padding:7px 22px;border:none;border-radius:4px;cursor:pointer;}

/* ERA / MILESTONE OVERLAY */
#eo{position:fixed;inset:0;background:rgba(0,0,0,.9);display:flex;align-items:center;justify-content:center;z-index:400;opacity:0;pointer-events:none;transition:opacity .5s;}
#eo.on{opacity:1;pointer-events:all;}
#ec{background:var(--panel);border:2px solid var(--accent);border-radius:12px;padding:32px 48px;text-align:center;max-width:520px;}
#ec.rebirth-card{border-color:#e879f9;background:linear-gradient(135deg,#0a0015,#1a0a2e);}
#ec h2{font-family:'Orbitron';font-size:20px;color:var(--accent);margin-bottom:10px;}
#ec.rebirth-card h2{color:#e879f9;}
#ec p{color:var(--text);font-size:11px;line-height:1.8;margin-bottom:16px;}
#ec-close{background:var(--accent);color:var(--bg);font-family:'Orbitron';font-size:10px;font-weight:700;padding:8px 24px;border:none;border-radius:4px;cursor:pointer;letter-spacing:2px;margin:4px;}
#ec-rebirth{background:linear-gradient(135deg,#9900cc,#ff0088);color:#fff;font-family:'Orbitron';font-size:10px;font-weight:700;padding:8px 24px;border:none;border-radius:4px;cursor:pointer;letter-spacing:2px;margin:4px;display:none;}
#ec-rebirth:hover{filter:brightness(1.2);}

/* BIG BANG OVERLAY */
#bbang{position:fixed;inset:0;background:#000;z-index:500;display:flex;align-items:center;justify-content:center;opacity:0;pointer-events:none;transition:opacity .5s;}
#bbang.on{opacity:1;pointer-events:all;}
#bbang canvas{position:absolute;inset:0;}
#bbang-text{position:relative;z-index:1;text-align:center;font-family:'Orbitron';}
#bbang-text h1{font-size:32px;color:#fff;margin-bottom:12px;text-shadow:0 0 20px #fff;}
#bbang-text p{font-size:13px;color:#adf;line-height:1.8;}

/* ACHIEVEMENTS */
#ach-toast{position:fixed;bottom:60px;right:14px;background:#1a1000;border:1px solid var(--gold);border-radius:6px;padding:8px 14px;font-size:9px;color:var(--gold);max-width:220px;opacity:0;transform:translateY(8px);transition:all .3s;pointer-events:none;z-index:300;font-family:'Orbitron';}
#ach-toast.on{opacity:1;transform:translateY(0);}

/* REBIRTH GLOW THEME */
body.rebirth1{--border2:#4a2870;}
body.rebirth2{--border2:#2a4870;--accent:#00ffaa;}
body.rebirth3{--border2:#702a4a;--accent:#ff88ff;}
</style>
</head>
<body>
<div id="header">
  <div id="gtitle">ENERGY ASCENSION</div>
  <div class="sblk"><div class="slbl">Power</div><div class="sval" id="sp">0 W</div><div class="srate">+<b id="rp2">0 W</b>/s</div></div>
  <div class="sblk"><div class="slbl">Energy</div><div class="sval" id="se">0 Wh</div><div class="srate">+<b id="re">0 Wh</b>/s</div></div>
  <div class="sblk"><div class="slbl">Credits</div><div class="sval" id="sc">500 ¢</div><div class="srate">+<b id="rc">0 ¢</b>/s</div></div>
  <div class="sblk"><div class="slbl">Structures</div><div class="sval" id="ss">0</div><div class="srate">Grid: <b id="sg">12×9</b></div></div>
  <div class="sblk" id="rebirth-blk"><div class="slbl">Rebirths</div><div class="sval" id="srb">0</div><div class="srate">Mult: <b id="smult">×1.00</b></div></div>
  <div id="era-disp">ERA I: FOSSIL AGE</div>
  <div id="spd">
    <button class="sb on" onclick="setSpd(1)" id="s1">1×</button>
    <button class="sb" onclick="setSpd(3)" id="s3">3×</button>
    <button class="sb" onclick="setSpd(10)" id="s10">10×</button>
  </div>
</div>

<div id="main">
  <div id="tp"><h3>Tech Tree</h3><div id="tlist"></div></div>
  <div id="ga">
    <div id="gw">
      <canvas id="pc"></canvas>
      <div id="grid"></div>
    </div>
    <div id="bb">
      <div id="it">Select a technology from the left, then click an empty grid cell to place it.</div>
      <button id="dbtn" onclick="togDem()">⚠ Demolish</button>
      <button id="plbtn" disabled>▶ Place</button>
    </div>
  </div>
  <div id="rp"><h3>Research Lab</h3><div id="rpanel"></div></div>
</div>

<div id="notif"></div>
<div id="ach-toast"></div>

<div id="event-banner">
  <div id="eb-title">EVENT</div>
  <div id="eb-desc"></div>
  <div id="eb-effect"></div>
  <button id="eb-close" onclick="closeEvent()">Acknowledge</button>
</div>

<div id="eo">
  <div id="ec">
    <h2 id="et">ERA</h2>
    <p id="ed"></p>
    <button id="ec-close" onclick="closeEra()">Continue →</button>
    <button id="ec-rebirth" onclick="doRebirth()">🌌 COLLAPSE &amp; REBIRTH</button>
  </div>
</div>

<div id="bbang">
  <canvas id="bbcanvas"></canvas>
  <div id="bbang-text">
    <h1 id="bb-title">BIG BANG</h1>
    <p id="bb-sub"></p>
  </div>
</div>

<script>
// ═══════════════════════════════════════
// TECH TREE — 30 structures
// ═══════════════════════════════════════
const TECHS=[
