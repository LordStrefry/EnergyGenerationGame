  const t=TECHS.find(t=>t.id===id);
  if(t){
    document.getElementById('it').innerHTML=`<span>${t.ic} ${t.n}</span> — ${t.desc} | Cost: <span>${fc(t.cost)}</span>`;
    document.getElementById('plbtn').disabled=false;
  }
  buildTechPanel();
}

// ═══════════════════════════════════════
// RESEARCH PANEL
// ═══════════════════════════════════════
function buildResPanel(){
  let html='';
  RES.forEach(r=>{
    if(r.cat){html+=`<div class="rcat">${r.cat}</div>`;return;}
    const ul=G.totalEnergy>=r.req||G.bought[r.id];
    if(!ul)return;
    const bt=G.bought[r.id];
    const cls=r.cls?` ${r.cls}`:'';
    html+=`<div class="ui${bt?' bought':''}${cls}" ${bt?'':`onclick="buyRes('${r.id}')"`}>
      <div class="un">${r.n}</div>
      <div class="ud">${r.d}</div>
      <div class="uc">${bt?'✓ Researched':fc(r.cost)}</div>
    </div>`;
  });
  document.getElementById('rpanel').innerHTML=html||`<div style="font-size:8px;color:var(--muted);padding:8px">Generate energy to unlock research.</div>`;
}

function buyRes(id){
  const r=RES.find(x=>x.id===id);
  if(!r||G.bought[id])return;
  if(G.credits<r.cost){ntf('Insufficient credits!','red');return;}
  G.credits-=r.cost;G.bought[id]=true;
  if(r.action==='unlock_rebirth'){G.rebirthUnlocked=true;ntf('Singularity Compression ready! Build Omega to rebirth.','purple');}
  recalc();buildResPanel();updateStats();
  ntf(`✓ ${r.n}`,'green');
}

// ═══════════════════════════════════════
// CELL INTERACTION
// ═══════════════════════════════════════
function onCell(k){
  if(G.demMode){
    if(G.cells[k]){delete G.cells[k];renderCell(k);recalc();updateStats();ntf('Demolished.','red');}
    return;
  }
  if(!G.selTech)return;
  if(G.cells[k]){ntf('Cell occupied!','red');return;}
  const t=TECHS.find(t=>t.id===G.selTech);
  if(!t)return;
  if(G.totalEnergy<t.unl&&t.unl>0){ntf(`Unlock at ${fe(t.unl)}`,'red');return;}
  if(G.credits<t.cost){ntf(`Need ${fc(t.cost)}`,'red');return;}
  G.credits-=t.cost;
  G.cells[k]={id:G.selTech};
  renderCell(k);recalc();updateStats();
  checkEra(t);burst(k,t);
  // Screen shake for big structures
  const bigEras=['VI','VII','VIII','IX','X','XI','XII','Ω'];
  if(bigEras.includes(t.era)){
    document.body.classList.remove('shake');
    void document.body.offsetWidth;
    document.body.classList.add('shake');
    setTimeout(()=>document.body.classList.remove('shake'),500);
  }
  ntf(`Built: ${t.ic} ${t.n}`,'green');
  checkAchievements();
}

function togDem(){
  G.demMode=!G.demMode;G.selTech=null;
  document.getElementById('plbtn').disabled=true;
  document.querySelectorAll('.ti').forEach(e=>e.classList.remove('sel'));
  document.getElementById('dbtn').classList.toggle('on',G.demMode);
  document.getElementById('it').innerHTML=G.demMode
    ?'<span style="color:var(--red)">DEMOLISH MODE</span> — Click a structure.'
    :'Select a technology, then click an empty cell.';
}

// ═══════════════════════════════════════
// TICK
// ═══════════════════════════════════════
function startTick(){if(tickInt)clearInterval(tickInt);tickInt=setInterval(tick,1000);}
function tick(){
  const dt=G.speed;
  G.totalEnergy+=G.currentPower*dt;
  G.credits+=G.creditRate*dt;
  updateStats();
  // Rebuild panels every 3s to avoid jank
  if(Math.round(G.totalEnergy)%3===0){buildTechPanel();buildResPanel();}
  tickParts();
  // Random events every ~45 seconds (randomised)
  if(Math.random()<(1/45)*dt)triggerEvent();
}
function setSpd(s){
  G.speed=s;
  ['s1','s3','s10'].forEach(i=>document.getElementById(i).classList.remove('on'));
  document.getElementById(`s${s}`).classList.add('on');
}
function updateStats(){
  document.getElementById('sp').textContent=fp(G.currentPower);
  document.getElementById('se').textContent=fe(G.totalEnergy);
  document.getElementById('sc').textContent=fc(G.credits);
  document.getElementById('ss').textContent=Object.keys(G.cells).length;
  document.getElementById('sg').textContent=`${G.gridCols}×${G.gridRows}`;
  document.getElementById('rp2').textContent=fp(G.currentPower);
  document.getElementById('re').textContent=fe(G.currentPower);
  document.getElementById('rc').textContent=fc(G.creditRate);
  document.getElementById('srb').textContent=G.rebirths;
  document.getElementById('smult').textContent=`×${G.rebirthMult.toFixed(2)}`;
}

// ═══════════════════════════════════════
// ERA
// ═══════════════════════════════════════
function checkEra(tech){
  if(G.seenEras.has(tech.era))return;
  G.seenEras.add(tech.era);G.era=tech.era;
  document.getElementById('era-disp').textContent=`ERA ${tech.era}: ${tech.en.toUpperCase()}`;
  const m=ERA_M[tech.era];if(!m)return;
  const card=document.getElementById('ec');
  card.className=tech.era==='Ω'?'rebirth-card':'';
  document.getElementById('et').textContent=m.t;
  document.getElementById('ed').textContent=m.d;
  document.getElementById('ec-close').style.display='inline-block';
  const rb=document.getElementById('ec-rebirth');
  rb.style.display=m.rebirth&&G.rebirthUnlocked?'inline-block':'none';
  document.getElementById('eo').classList.add('on');
}
function closeEra(){document.getElementById('eo').classList.remove('on');}

// ═══════════════════════════════════════
// REBIRTH
// ═══════════════════════════════════════
function doRebirth(){
  closeEra();
  // Determine multiplier gain
  const mult=2+G.rebirths*0.5;
  G.rebirths++;
  G.rebirthMult*=mult;
  // Clear grid and credits but keep rebirths and bought
  G.cells={};
  G.credits=500*G.rebirthMult;
  G.totalEnergy=0;
  G.currentPower=0;
  G.creditRate=0;
  G.selTech=null;
  G.demMode=false;
  G.seenEras=new Set(['I']);
  G.era='I';
  // Keep research bought except rebirth unlock and omega
  const keepRes=new Set(['rb_prep']);
  Object.keys(G.bought).forEach(k=>{if(keepRes.has(k))delete G.bought[k];});
  // Apply rebirth visual theme
  document.body.className=`rebirth${Math.min(G.rebirths,3)}`;
  document.getElementById('era-disp').textContent='ERA I: FOSSIL AGE';
  buildGrid();buildTechPanel();buildResPanel();updateStats();
  checkAchievements();
  triggerBigBang(mult);
}

function triggerBigBang(mult){
  const overlay=document.getElementById('bbang');
  const cv=document.getElementById('bbcanvas');
  bbCanvas=cv;
  cv.width=window.innerWidth;cv.height=window.innerHeight;
  bbCtx=cv.getContext('2d');
  bbParts=[];
  document.getElementById('bb-title').textContent='BIG BANG';
  document.getElementById('bb-sub').innerHTML=`Universe reborn.<br>Permanent multiplier: ×${G.rebirthMult.toFixed(1)}<br>Rebirth #${G.rebirths}`;
  overlay.classList.add('on');
  // Spawn big bang particles from centre
  const cx=cv.width/2,cy=cv.height/2;
  for(let i=0;i<300;i++){
    const a=Math.random()*Math.PI*2,spd=2+Math.random()*12;
    const hue=Math.random()*360;
    bbParts.push({x:cx,y:cy,vx:Math.cos(a)*spd,vy:Math.sin(a)*spd,
      life:1,dec:0.004+Math.random()*0.008,sz:2+Math.random()*6,
      col:`hsl(${hue},100%,70%)`});
  }
  animBB();
  setTimeout(()=>{overlay.classList.remove('on');ntf(`Rebirth #${G.rebirths} — ×${G.rebirthMult.toFixed(1)} permanent!`,'purple');},4000);
}

function animBB(){
  if(!bbCtx)return;
  bbCtx.fillStyle='rgba(0,0,0,0.06)';
  bbCtx.fillRect(0,0,bbCanvas.width,bbCanvas.height);
  bbParts=bbParts.filter(p=>{
    p.x+=p.vx;p.y+=p.vy;p.life-=p.dec;
    if(p.life<=0)return false;
    bbCtx.save();
    bbCtx.globalAlpha=p.life;
    bbCtx.fillStyle=p.col;
    bbCtx.shadowBlur=16;bbCtx.shadowColor=p.col;
    bbCtx.beginPath();
    bbCtx.arc(p.x,p.y,p.sz*p.life,0,Math.PI*2);
    bbCtx.fill();
    bbCtx.restore();
    return true;
  });
  if(bbParts.length>0||document.getElementById('bbang').classList.contains('on'))requestAnimationFrame(animBB);
}

// ═══════════════════════════════════════
// RANDOM EVENTS
// ═══════════════════════════════════════
let eventCooldown=0;
function triggerEvent(){
  if(eventCooldown>0){eventCooldown--;return;}
  const ev=EVENTS[Math.floor(Math.random()*EVENTS.length)];
  document.getElementById('eb-title').textContent=ev.t;
  document.getElementById('eb-desc').textContent=ev.d;
  document.getElementById('eb-effect').textContent=ev.e;
  document.getElementById('event-banner').classList.add('on');
  // Apply effect
  if(ev.eff==='buff'){G.eventMod*=ev.val;setTimeout(()=>{G.eventMod/=ev.val;recalc();},ev.dur*1000);}
  else if(ev.eff==='debuff'){G.eventMod*=ev.val;setTimeout(()=>{G.eventMod/=ev.val;recalc();},ev.dur*1000);G.negEventsSurvived++;checkAchievements();}
  else if(ev.eff==='crbuff'){G.crEventMod*=ev.val;setTimeout(()=>{G.crEventMod/=ev.val;},ev.dur*1000);}
  else if(ev.eff==='crdebuff'){G.crEventMod*=ev.val;setTimeout(()=>{G.crEventMod/=ev.val;},ev.dur*1000);}
  else if(ev.eff==='credits'){G.credits+=G.credits*ev.val;}
  else if(ev.eff==='minute_credits'){G.credits+=G.creditRate*60;}
  else if(ev.eff==='permupgrade'){
    const keys=Object.keys(G.cells);
    if(keys.length>0){
      const k=keys[Math.floor(Math.random()*keys.length)];
      const techId=G.cells[k].id;
      G.permUpgrades[techId]=(G.permUpgrades[techId]||1)*2;
      recalc();
    }
  }
  recalc();
  eventCooldown=30;
}
function closeEvent(){document.getElementById('event-banner').classList.remove('on');}

// ═══════════════════════════════════════
// ACHIEVEMENTS
// ═══════════════════════════════════════
function checkAchievements(){
  ACHIEVEMENTS.forEach(a=>{
    if(G.achievementsEarned.has(a.id))return;
    if(a.check(G)){
      G.achievementsEarned.add(a.id);
      showAch(a);
    }
  });
}
function showAch(a){
  const el=document.getElementById('ach-toast');
  el.innerHTML=`🏆 ${a.n}<br><span style="color:var(--muted);font-size:7px">${a.d}</span>`;
  el.classList.add('on');
  if(achTimer)clearTimeout(achTimer);
  achTimer=setTimeout(()=>el.classList.remove('on'),3000);
}

// ═══════════════════════════════════════
// NOTIFICATIONS
// ═══════════════════════════════════════
function ntf(msg,type='blue'){
  const n=document.getElementById('notif');
  const c={green:'#00ff9d',red:'#ff4444',blue:'#00c8ff',purple:'#e879f9'};
  n.style.color=c[type]||c.blue;n.style.borderColor=c[type]||c.blue;
  n.textContent=msg;n.classList.add('on');
  if(ntTimer)clearTimeout(ntTimer);
  ntTimer=setTimeout(()=>n.classList.remove('on'),2200);
}

// ═══════════════════════════════════════
// PARTICLE SYSTEM
// ═══════════════════════════════════════
const PC={
  gc:['#ff6633','#ff4400','#ff8855'],go:['#ffaa33','#ff8800','#ffcc44'],
  gg:['#ffee44','#ffdd00','#ffffaa'],gn:['#33ff66','#00ff44','#88ffaa'],
  gs:['#ffdd00','#ffee55','#fff066'],gw2:['#88ccff','#aaddff'],
  gh:['#3399ff','#55aaff','#88ccff'],ggeo:['#ff4422','#ff6633','#ff8844'],
  gf:['#ff9900','#ffbb00','#ff7700'],gorb:['#ffff00','#ffee00','#ffffaa'],
  ganti:['#ff44ff','#cc00ff','#ff88ff'],gdy:['#ff9933','#ffaa44','#ffcc88'],
  gdpe:['#00ffff','#00ccff','#88ffff'],gdcs:['#ff9900','#ffcc00','#fff','#ff6600'],
  gmp:['#ff00ff','#ff44ff','#fff','#cc00ff'],
  gpulsar:['#fff','#aabbff','#eeeeff','#ffffff'],
  gquasar:['#ff4400','#ff8800','#ffcc00','#ff2200'],
  gnmerge:['#66ffff','#ff66ff','#00ffee','#ff00ff'],
  gzpt:['#ffffff','#ccccff','#aaaaff','#ffffff'],
  gvac:['#ffaa00','#ff8800','#ffdd88'],
  gcstr:['#00ffaa','#00ff55','#88ffcc'],
  gbrane:['#ff00aa','#aa00ff','#ff44cc','#0000ff'],
  gkd1:['#00ff88','#00dd66','#88ffcc'],
  gkd2:['#ffcc00','#ff9900','#ffee88'],
  gkd3:['#ff44ff','#aa00ff','#ff88ff'],
  gkd4:['#00ccff','#aa00ff','#ff0000','#ffffff'],
  gomega:['#ffff00','#00ffff','#ff00ff','#ffffff','#ff8800'],
};

function resizeCv(){
  const w=document.getElementById('gw');
  canvas=document.getElementById('pc');
  canvas.width=Math.max(w.scrollWidth,900);
  canvas.height=Math.max(w.scrollHeight,700);
  ctx=canvas.getContext('2d');
}
function cellXY(k){
  const[r,c]=k.split(',').map(Number);
  return{x:GPAD+c*CSIZ+CSIZ/2,y:GPAD+r*CSIZ+CSIZ/2};
}
function burst(k,tech){
  const{x,y}=cellXY(k);
  const cols=PC[tech.gl]||['#fff'];
  const count=tech.era==='Ω'?80:tech.era==='XII'?50:tech.era>='IX'?36:24;
  for(let i=0;i<count;i++){
    const a=Math.random()*Math.PI*2,spd=1.5+Math.random()*(tech.era==='Ω'?8:4);
    parts.push({x,y,vx:Math.cos(a)*spd,vy:Math.sin(a)*spd-1,
      life:1,dec:0.018+Math.random()*0.03,sz:2+Math.random()*(tech.era==='Ω'?8:5),
      col:cols[Math.floor(Math.random()*cols.length)],type:'burst'});
  }
}
function spawnIdle(k,tech){
  const{x,y}=cellXY(k);
  const cols=PC[tech.gl]||['#fff'];
  const a=Math.random()*Math.PI*2,spd=0.1+Math.random()*0.7;
  const eraW={'I':1,'II':1,'III':2,'IV':3,'V':4,'VI':6,'VII':8,'VIII':10,'IX':12,'X':14,'XI':16,'XII':18,'Ω':25};
  parts.push({
    x:x+(Math.random()-0.5)*18,y:y+(Math.random()-0.5)*18,
    vx:Math.cos(a)*spd,vy:Math.sin(a)*spd-0.35,
    life:1,dec:0.007+Math.random()*0.012,sz:1+Math.random()*2.5,
    col:cols[Math.floor(Math.random()*cols.length)],
    w:eraW[tech.era]||1,type:'idle'
  });
}
function tickParts(){
  idleTk++;
  if(idleTk%2!==0)return;
  Object.keys(G.cells).forEach(k=>{
    const t=TECHS.find(t=>t.id===G.cells[k].id);
    if(!t)return;
    const w=({'I':1,'II':1,'III':2,'IV':3,'V':5,'VI':8,'VII':10,'VIII':14,'IX':16,'X':18,'XI':20,'XII':22,'Ω':30})[t.era]||1;
    for(let i=0;i<Math.min(w,20);i++)spawnIdle(k,t);
  });
}
function animParts(){
  if(ctx){
    ctx.clearRect(0,0,canvas.width,canvas.height);
    parts=parts.filter(p=>{
      p.x+=p.vx;p.y+=p.vy;p.vy-=0.025;p.life-=p.dec;
      if(p.life<=0)return false;
      ctx.save();
      ctx.globalAlpha=p.life*0.8;
      ctx.fillStyle=p.col;
      ctx.shadowBlur=p.type==='burst'?16:8;
      ctx.shadowColor=p.col;
      ctx.beginPath();
      ctx.arc(p.x,p.y,p.sz*p.life,0,Math.PI*2);
      ctx.fill();
      ctx.restore();
      return true;
    });
    // Limit particle count for perf
    if(parts.length>1200)parts=parts.slice(parts.length-1200);
  }
  requestAnimationFrame(animParts);
}

// ═══════════════════════════════════════
// INIT
// ═══════════════════════════════════════
function init(){
  buildGrid();buildTechPanel();buildResPanel();updateStats();
  startTick();animParts();
  window.addEventListener('resize',resizeCv);
  setTimeout(()=>{
    const m=ERA_M['I'];
    const card=document.getElementById('ec');
    card.className='';
    document.getElementById('et').textContent=m.t;
    document.getElementById('ed').textContent=m.d;
    document.getElementById('ec-rebirth').style.display='none';
    document.getElementById('eo').classList.add('on');
  },600);
}
init();
</script>
